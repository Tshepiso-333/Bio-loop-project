# PayFast credentials — copy this file to `.env.payfast` (already gitignored)
# and fill in real values. `.env.payfast` is a LOCAL REFERENCE ONLY.
#
# IMPORTANT: these values must never be read directly by the React Native
# app (no EXPO_PUBLIC_PAYFAST_* vars) and must never be committed. They get
# copied into Supabase Edge Function secrets instead (`supabase secrets
# set ...`), because PAYFAST_MERCHANT_KEY / PAYFAST_PASSPHRASE are used to
# generate signed payment requests server-side — if they ship inside the
# app bundle, anyone can decompile the app and forge payment requests.
# See docs/PAYFAST_INTEGRATION.md.

PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Sandbox process URL (real PayFast test environment):
PAYFAST_PROCESS_URL=https://sandbox.payfast.co.za/eng/process

# Live process URL (only used once PAYFAST_MODE=live):
# PAYFAST_PROCESS_URL=https://www.payfast.co.za/eng/process
